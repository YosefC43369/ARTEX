<?xml version="1.0" encoding="UTF-8"?>
<!--
  ARTEX Autonomous Penetration-Testing Subsystem — scope configuration.

  SAFETY CONTRACT (enforced in the Python backend, not by prompts):
    * This file is the ONLY source of authorization. If it is missing or
      invalid, the subsystem refuses to start (fail-closed).
    * A target that is not listed here can never be assessed.
    * Capabilities default to FALSE. A target may only use a capability that is
      explicitly set to true below.
    * Runtime limits are clamped to hard safety ceilings in code; you can make
      an engagement safer here, never more permissive than the ceiling.

  Edit this file to define YOUR OWN authorized targets. Only assess systems you
  own or have explicit written permission to test.
-->
<artex_pentest>

  <engagement>
    <!-- Autonomous loop is OFF by default; turn on only for authorized runs. -->
    <autonomous_enabled>false</autonomous_enabled>

    <!-- Bounds (clamped to code ceilings: iters<=100, runtime<=3600s, conc<=16,
         rps<=20, tasks<=500). The loop stops when ANY bound trips. -->
    <max_iterations>25</max_iterations>
    <max_runtime_seconds>1200</max_runtime_seconds>
    <max_concurrency>4</max_concurrency>
    <max_requests_per_second>2.0</max_requests_per_second>
    <max_tasks>200</max_tasks>

    <evidence_enabled>true</evidence_enabled>
    <!-- Optional: directory for persisted evidence JSON. Empty = memory only. -->
    <evidence_dir></evidence_dir>

    <report_formats>json,markdown,html</report_formats>
    <log_level>INFO</log_level>

    <features>
      <llm_planning>true</llm_planning>
    </features>
  </engagement>

  <targets>
    <!-- Sample target. Replace with your own authorized scope. -->
    <target id="example-target">
      <domain>example.com</domain>
      <url>https://example.com</url>

      <!-- Hosts considered in-scope. The target domain is always included. -->
      <allowed_domains>example.com</allowed_domains>
      <allow_wildcard_subdomains>true</allow_wildcard_subdomains>

      <allowed_protocols>https</allowed_protocols>
      <allowed_ports>443</allowed_ports>

      <!-- Empty allowed_paths = all paths permitted. excluded_paths always win. -->
      <allowed_paths></allowed_paths>
      <excluded_paths>/admin,/logout,/billing</excluded_paths>
      <excluded_hosts></excluded_hosts>

      <max_requests_per_second>2.0</max_requests_per_second>
      <max_concurrency>4</max_concurrency>

      <!-- Capabilities: unlisted or false = denied. Active/intrusive ones are
           off by default; enable only with explicit authorization. -->
      <permissions>
        <recon>true</recon>
        <tls_inspection>true</tls_inspection>
        <http_analysis>true</http_analysis>
        <header_analysis>true</header_analysis>
        <subdomain_takeover>true</subdomain_takeover>
        <llm_planning>true</llm_planning>
        <port_scan>false</port_scan>
        <active_web_testing>false</active_web_testing>
        <api_testing>false</api_testing>
      </permissions>
    </target>
  </targets>

</artex_pentest>
