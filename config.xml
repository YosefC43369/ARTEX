<?xml version="1.0" encoding="UTF-8"?>
<!--
  ARTEX Red-Team Scope — authorized targets.

  USAGE (the simple case): just list the authorized URLs. Each <target> is one
  URL you have written permission to test. That URL is the authorization, and
  ARTEX will run its full offensive capability set (recon + active testing)
  against it, confined to that target's domain.

      <target>https://clientsite.com</target>

  Only assess systems you own or have explicit written permission to test.

  SAFETY RAILS still enforced in code regardless of this file:
    * A target not listed here can never be touched (fail-closed).
    * Testing is confined to the target's domain (and its subdomains).
    * Hosts that resolve to private/loopback/internal IPs are blocked.
    * Per-target request-rate limiting applies.

  OPTIONAL: to RESTRICT a target to specific capabilities, give it an explicit
  <permissions> block (otherwise every capability is granted). See the commented
  example at the bottom.
-->
<artex_pentest>

  <engagement>
    <autonomous_enabled>true</autonomous_enabled>
    <report_formats>json,markdown,html</report_formats>
    <evidence_enabled>true</evidence_enabled>
  </engagement>

  <targets>
    <!-- The simplest form: one authorized URL per line. -->
    <target>https://example.com</target>
    <target>https://www.example.com</target>
  </targets>

  <!--
  OPTIONAL restricted target (only runs the listed capabilities):

  <targets>
    <target id="recon-only">
      <urls>
        <url>https://staging.client.com</url>
      </urls>
      <permissions>
        <recon>true</recon>
        <tls_inspection>true</tls_inspection>
      </permissions>
    </target>
  </targets>
  -->

</artex_pentest>
